{
  "name": "@hydrotik/air",
  "version": "0.3.0",
  "description": "Real-time AI observability — monitor context windows, tool calls, token costs, and compaction for coding agents.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "air": "dist/server/cli.js",
    "air-install-claude-code": "src/collectors/claude-code/install.cjs",
    "air-codex-watcher": "src/collectors/codex/watcher.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "require": "./dist/sdk/index.cjs"
    },
    "./server": {
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "src/collectors",
    "README.md",
    "INTEGRATION_PROMPT_README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "observability",
    "rum",
    "telemetry",
    "mcp",
    "rag",
    "llm",
    "coding-agent",
    "context-window",
    "token-usage",
    "claude",
    "codex",
    "pi",
    "pi-package",
    "dashboard",
    "drift-detection",
    "cost-tracking"
  ],
  "pi": {
    "extensions": [
      "./dist/collectors/pi/index.js"
    ]
  },
  "homepage": "https://github.com/hydrotik/air#readme",
  "bugs": {
    "url": "https://github.com/hydrotik/air/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hydrotik/air.git",
    "directory": "packages/air"
  },
  "scripts": {
    "dev": "tsx watch src/server/start.ts",
    "build": "rimraf dist && tsup",
    "start": "node dist/server/cli.js",
    "start:detached": "node scripts/start-detached.mjs",
    "stop": "node scripts/start-detached.mjs --stop",
    "test": "jest --config jest.config.mjs",
    "test:coverage": "jest --config jest.config.mjs --coverage",
    "test:watch": "jest --config jest.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@sinclair/typebox": "^0.34.33",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@types/ws": "^8.5.14",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
