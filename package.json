{
  "name": "air-repo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @hydrotik/air build",
    "build:dashboard": "pnpm --filter @hydrotik/air-dashboard build",
    "dev": "pnpm --filter @hydrotik/air dev",
    "dev:dashboard": "pnpm --filter @hydrotik/air-dashboard dev",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm --filter @hydrotik/air typecheck",
    "typecheck:dashboard": "pnpm --filter @hydrotik/air-dashboard typecheck",
    "lint": "oxlint --fix packages",
    "lint:ci": "oxlint packages",
    "lint:typed": "oxlint --type-aware packages",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:clean": "node scripts/check-clean.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~5.9.3"
  }
}
